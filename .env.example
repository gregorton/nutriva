# Copy to .env.local (gitignored) and fill in.
#
# Neon (https://neon.com): create a project, then Connect → copy the pooled connection string.
# The host has "-pooler" in it — that is the one to use; the direct host runs out of connections.
#
# Local Postgres instead? postgresql://postgres:PASSWORD@localhost:5432/slimwellness — TLS is skipped
# automatically for localhost (see lib/db.ts).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full

# ---- Signing in with a provider (optional) ----
#
# Leave a pair blank and that button does not appear; nothing else changes. Sessions are opaque
# tokens in the database either way, so there is still no signing secret to manage.
#
# Google — console.cloud.google.com → APIs & Services → Credentials → OAuth client ID → Web
# application. Authorised redirect URI, one per origin you run on:
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook — developers.facebook.com/apps → create a Consumer app → add Facebook Login → Settings.
# Valid OAuth Redirect URI:
#   http://localhost:3000/api/auth/facebook/callback
# Until the app passes business verification it only works for accounts listed as testers.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Only needed when the app sits behind a proxy that rewrites the host, so the redirect URI it
# builds no longer matches what is registered. Otherwise it is derived from the request.
# OAUTH_REDIRECT_ORIGIN=https://slimwellness.example

# ---- The internal dashboard at /admin (optional) ----
#
# Comma-separated addresses. Leave it blank and /admin 404s for everybody, including you — there
# is no default administrator.
#
# Order matters, because nothing on this site verifies an email address: whoever registers an
# allowlisted address first gets in. Create the accounts through /signup, confirm they exist, and
# only then paste their addresses here. Adding an address nobody has registered leaves it open to
# whoever claims it.
#
# Access is revoked by editing this line and redeploying. There is no admin flag in the database.
ADMIN_EMAILS=
